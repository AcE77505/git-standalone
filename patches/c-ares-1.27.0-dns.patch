+static ares_bool_t ares__servers_only_loopback(ares_channel_t *channel)
+{
+  ares__slist_node_t *node;
+
+  if (channel == NULL || ares__slist_len(channel->servers) == 0)
+    return ARES_FALSE;
+
+  for (node = ares__slist_node_first(channel->servers); node != NULL;
+       node = ares__slist_node_next(node)) {
+    const struct server_state *server = ares__slist_node_val(node);
+
+    if (server->addr.family == AF_INET) {
+      unsigned int a = ntohl(server->addr.addr.addr4.s_addr);
+      if ((a >> 24) != 127)   /* not 127.0.0.0/8 loopback */
+        return ARES_FALSE;
+    } else if (server->addr.family == AF_INET6) {
+      /* ares_in6_addr is not a standard struct in6_addr; check for ::1
+       * manually by looking at the raw bytes. */
+      const unsigned char *b =
+          (const unsigned char *)&server->addr.addr.addr6;
+      int i, allzero = 1;
+      for (i = 0; i < 15; i++) {
+        if (b[i] != 0) {
+          allzero = 0;
+          break;
+        }
+      }
+      if (!(allzero && b[15] == 1))
+        return ARES_FALSE;
+    } else {
+      return ARES_FALSE;
+    }
+  }
+  return ARES_TRUE;
+}
