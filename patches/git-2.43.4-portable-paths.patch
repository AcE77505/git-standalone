diff -ruN git-base/config.c git-port/config.c
--- git-base/config.c	2026-11-15 16:09:05.908448000 +0800
+++ git-port/config.c	2026-11-15 16:09:59.031915900 +0800
@@ -2005,8 +2005,19 @@
 	char *xdg_config = NULL;
 
 	if (!user_config) {
-		user_config = interpolate_path("~/.gitconfig", 0);
-		xdg_config = xdg_config_home("config");
+		const char *home = getenv("HOME");
+
+		/*
+		 * Portable build: if HOME is missing or not writable (common
+		 * in Android shells), keep the global config next to the
+		 * executable rather than failing or writing to /.
+		 */
+		if (!home || !*home || access(home, W_OK) != 0) {
+			user_config = system_path("gitconfig");
+		} else {
+			user_config = interpolate_path("~/.gitconfig", 0);
+			xdg_config = xdg_config_home("config");
+		}
 	}
 
 	*user_out = user_config;
diff -ruN git-base/exec-cmd.c git-port/exec-cmd.c
--- git-base/exec-cmd.c	2026-11-15 16:09:06.847729000 +0800
+++ git-port/exec-cmd.c	2026-11-15 16:09:41.266213700 +0800
@@ -47,17 +47,23 @@
 {
 	static const char *prefix;
 
-	assert(executable_dirname);
+	if (!executable_dirname)
+		return ".";
+
 	assert(is_absolute_path(executable_dirname));
 
 	if (!prefix &&
 	    !(prefix = strip_path_suffix(executable_dirname, GIT_EXEC_PATH)) &&
 	    !(prefix = strip_path_suffix(executable_dirname, BINDIR)) &&
 	    !(prefix = strip_path_suffix(executable_dirname, "git"))) {
-		prefix = FALLBACK_RUNTIME_PREFIX;
-		trace_printf("RUNTIME_PREFIX requested, "
-				"but prefix computation failed.  "
-				"Using static fallback '%s'.\n", prefix);
+		/*
+		 * Portable/single-file build: there is no install prefix on
+		 * disk. Resolve relative resource paths next to the executable
+		 * instead of falling back to a build-machine path.
+		 */
+		prefix = executable_dirname;
+		trace_printf("RUNTIME_PREFIX: using executable directory '%s'\n",
+			     prefix);
 	}
 	return prefix;
 }
